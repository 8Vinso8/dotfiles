{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "padding": {
            "top": 1,
            "right": 3
        },
        "color": {
            "1": "38;2;203;166;247", // Catppuccin Mauve
            "2": "38;2;137;180;250"  // Catppuccin Blue
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "separator": "38;2;88;91;112" // Catppuccin Surface2
        },
        "size": {
            "ndigits": 1
        },
        "duration": {
            "abbreviation": true,
            "spaceBeforeUnit": "never"
        }
    },
    "modules": [
        {
            "type": "title",
            "color": {
                "user": "38;2;203;166;247", // Mauve
                "at": "38;2;108;112;134",   // Overlay0
                "host": "38;2;180;190;254"  // Lavender
            }
        },
        {
            "type": "separator",
            "string": "─"
        },
        {
            "type": "os",
            "key": " ",
            "keyColor": "38;2;137;180;250", // Blue
            "format": "{pretty-name}"
        },
        {
            "type": "kernel",
            "key": " ",
            "keyColor": "38;2;203;166;247", // Mauve
            "format": "{release}"
        },
        {
            "type": "uptime",
            "key": "󰅐 ",
            "keyColor": "38;2;250;179;135"  // Peach
        },
        {
            "type": "packages",
            "key": "󰏖 ",
            "keyColor": "38;2;249;226;175", // Yellow
            "format": "{all} (pacman)"
        },
        {
            "type": "wm",
            "key": " ",
            "keyColor": "38;2;180;190;254", // Lavender
            "format": "{pretty-name}"
        },
        {
            "type": "terminal",
            "key": " ",
            "keyColor": "38;2;166;227;161", // Green
            "format": "{pretty-name}"
        },
        {
            "type": "shell",
            "key": " ",
            "keyColor": "38;2;148;226;213", // Teal
            "format": "{exe-name} {version}"
        },
        {
            "type": "cpu",
            "key": " ",
            "keyColor": "38;2;243;139;168", // Red
            "format": "{name}"
        },
        {
            "type": "gpu",
            "key": "󰾲 ",
            "keyColor": "38;2;242;205;205", // Flamingo
            "format": "{name}"
        },
        {
            "type": "memory",
            "key": " ",
            "keyColor": "38;2;203;166;247", // Mauve
            "format": "{used} / {total} ({percentage})"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
