configuration {
  modes: [ drun ];
  drun-display-format: "{name}";
}

@theme "dmenu"

* {
  font: "JetBrains Mono 13";
  background-color: rgb(30, 30, 46);
  text-color: rgb(205, 214, 244);
  border-color: rgb(203, 166, 247);
}

window {
  width: 40%;
  y-offset: 10px;
  border: 2px;
  border-radius: 10px;
  padding: 6px;
  background-color: rgb(30, 30, 46);
}

prompt {
  enabled: false;
}

entry {
  placeholder: "Search...";
  padding: 7px 10px;
  background-color: rgb(24, 24, 37);
  border-radius: 6px;
  cursor-color: rgb(203, 166, 247);
}

listview {
  spacing: 4px;
}

element {
  padding: 6px 9px;
  border-radius: 6px;
}

element selected {
  background-color: rgb(49, 50, 68);
  text-color: rgb(203, 166, 247);
}

element-text {
  background-color: inherit;
  text-color: inherit;
}
